# II-Agent Local Development Environment
# Copy this file to .env:  cp .env.example .env
# Then fill in your API keys below.

# ─── Core ─────────────────────────────────────────────────────────
ENVIRONMENT=local

# ─── Database (matches docker infra defaults) ─────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ii_agent

# ─── Redis ────────────────────────────────────────────────────────
REDIS_SESSION_URL=redis://localhost:6379/0
REDIS_SESSION_ENABLED=true

# ─── Storage (local or minio for development) ────────────────────
STORAGE_PROVIDER=minio
STORAGE_BUCKET_NAME=ii-agent-dev
STORAGE_MINIO_ENDPOINT=localhost:9000
STORAGE_MINIO_ACCESS_KEY=minioadmin
STORAGE_MINIO_SECRET_KEY=minioadmin
STORAGE_MINIO_SECURE=false

# ─── Auth ─────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=43200
JWT_SECRET_KEY=local-dev-secret-change-in-production
OAUTHLIB_INSECURE_TRANSPORT=1

# Google OAuth (optional — leave empty to skip Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# II OAuth (optional for local development, but required to finish
# the OpenAI -> II staged sign-in bridge)
# II_CLIENT_ID=
# II_REDIRECT_URI=http://localhost:8000/auth/oauth/ii/callback

# Local dev auth bypass (enabled automatically in ENVIRONMENT=local when
# II_CLIENT_ID is empty; set explicitly if you want the same behavior in dev)
# DEV_AUTH_BYPASS_ENABLED=true
# DEV_AUTH_BYPASS_EMAIL=dev@ii-agent.local
# DEV_AUTH_BYPASS_FIRST_NAME=Local
# DEV_AUTH_BYPASS_LAST_NAME=Developer

# ─── Composio (optional — needed for Composio connectors/MCP) ─────
# COMPOSIO_API_KEY=
# Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# COMPOSIO_ENCRYPTION_KEY=
# COMPOSIO_WEBHOOK_SECRET=
# COMPOSIO_REDIRECT_URI=http://localhost:1420/auth/oauth/composio/callback

# ─── Frontend URL ─────────────────────────────────────────────────
II_FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ─── LLM Configuration ───────────────────────────────────────────
# At least one LLM must be configured for the agent to work.
# Uncomment and fill in the provider(s) you want to use.

# Option A: Inline JSON array
# MODEL_CONFIGS='[{"model_id":"gpt-5.2","provider":"OpenAI","api_key":"sk-...","display_name":"GPT-5.2","is_default":true}]'

# Option B: YAML file (see model_configs.example.yaml)
# MODEL_CONFIGS_FILE=model_configs.yaml

# Provider values: OpenAI | Anthropic | Google | Cerebras | Custom
# API type values (in params.api_type): vertex_ai | azure | bedrock | null

# ─── Sandbox (optional — needed for code execution) ──────────────
# Default free/self-hosted provider:
# SANDBOX_PROVIDER=daytona
# SANDBOX_DAYTONA_API_URL=http://localhost:3980/api
# SANDBOX_DAYTONA_API_KEY=
# SANDBOX_DAYTONA_TARGET=
# SANDBOX_DAYTONA_DEFAULT_IMAGE=ii-agent-codex-sandbox:local
# SANDBOX_DAYTONA_SNAPSHOT=
# SANDBOX_DAYTONA_AUTO_STOP_INTERVAL=15
# SANDBOX_DAYTONA_EPHEMERAL=true
# SANDBOX_DAYTONA_PUBLIC_PREVIEW=true
# SANDBOX_DAYTONA_NETWORK_BLOCK_ALL=false
# SANDBOX_DAYTONA_NETWORK_ALLOW_LIST=[]
# ./scripts/start.sh auto-starts the Daytona OSS stack for local Daytona URLs.
# Override generated Daytona ports when needed:
# II_AGENT_DAYTONA_API_PORT=3980
# II_AGENT_DAYTONA_PROXY_PORT=3981
# II_AGENT_DAYTONA_COMPOSE_ATTEMPTS=3
# II_AGENT_DAYTONA_COMPOSE_PARALLEL_LIMIT=1
# II_AGENT_DAYTONA_OUTER_NETWORK_SUBNET=172.31.0.0/16
# II_AGENT_DAYTONA_SANDBOX_DOCKERFILE=docker/sandbox/daytona.Dockerfile
# E2B remains available when explicitly configured:
# SANDBOX_PROVIDER=e2b
# SANDBOX_E2B_API_KEY=
# Local Docker sandbox remains available for local Codex-only development:
# SANDBOX_PROVIDER=docker
# Local Docker sandbox builds install this exact OpenAI Codex CLI version.
# SANDBOX_CODEX_CLI_VERSION=0.124.0

# Codex App Server workflow parity stays disabled in production until the
# configured sandbox image/template has passed `uv run pytest -m codex_smoke`.
# CODEX_APP_SERVER_WORKFLOWS_ENABLED=true
# CODEX_APP_SERVER_SMOKE_VERIFIED=false

# ─── Tool Server (optional) ──────────────────────────────────────
# TOOL_SERVER_URL=http://localhost:1236

# ─── Prompt Enhancement (optional) ───────────────────────────────
# ENHANCE_PROMPT_OPENAI_API_KEY=

# ─── Web Search (optional) ───────────────────────────────────────
# WEB_SEARCH_SERPAPI_API_KEY=
# WEB_VISIT_FIRECRAWL_API_KEY=
# WEB_VISIT_JINA_API_KEY=
